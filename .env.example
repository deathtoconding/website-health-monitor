# Copy values into your shell/service environment and adjust as needed.
# The app binds to loopback by default; do not expose the unauthenticated UI/API publicly.
WHM_HOST=127.0.0.1
WHM_PORT=8000
WHM_DATABASE_PATH=./data/website-health-monitor.db

# New websites inherit these values; per-site values can be changed in the dashboard/API.
WHM_INTERVAL_SECONDS=60
WHM_TIMEOUT_SECONDS=10
WHM_FAILURE_THRESHOLD=2
WHM_RECOVERY_THRESHOLD=2
WHM_LATENCY_WARN_MS=1000
WHM_LATENCY_FAIL_MS=3000
WHM_TLS_WARNING_DAYS=30

WHM_SCHEDULER_POLL_SECONDS=1
WHM_MAX_CONCURRENT_CHECKS=20
WHM_LOG_LEVEL=INFO

# Optional. Leave empty to record transition events without sending webhooks.
# Use an HTTPS endpoint where practical; configure this only from a trusted environment.
WHM_WEBHOOK_URL=
WHM_WEBHOOK_TIMEOUT_SECONDS=5
WHM_WEBHOOK_MAX_ATTEMPTS=5
WHM_NOTIFICATION_POLL_SECONDS=2
