[Unit]
Description=Website Health Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=whm
Group=whm
WorkingDirectory=/opt/website-health-monitor
EnvironmentFile=-/etc/website-health-monitor.env
Environment=WHM_DATABASE_PATH=/var/lib/website-health-monitor/health.db
ExecStart=/opt/website-health-monitor/.venv/bin/python -m app
Restart=on-failure
RestartSec=5s
TimeoutStopSec=130s
KillSignal=SIGINT
UMask=0027
StateDirectory=website-health-monitor
StateDirectoryMode=0750
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/website-health-monitor
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
