{
  // Repository-wide editor defaults. `.vscode/*` is ignored by Git except for
  // this file and extensions.json, so personal overrides stay local.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "charliermarsh.ruff",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.fixAll": "explicit" },
    "editor.rulers": [100]
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    ".venv": true,
    "data": true,
    "dist": true
  },
  // Keep AI-generated commits conventional and reviewable.
  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "text": "Use Conventional Commits: type(scope): imperative summary. Types: feat, fix, docs, test, refactor, chore, ci, build, perf." },
    { "text": "Do not describe unrelated files; this repository merges one logical change per commit." }
  ],
  "editor.rulers": [100],
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "[markdown]": { "editor.defaultFormatter": "vscode.markdown-language-features" }
}
