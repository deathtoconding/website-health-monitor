# Editor defaults shared by humans and AI assistants.
# Ruff owns Python formatting; this file only removes ambiguity for everything else.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,js,css,html}]
indent_size = 2
max_line_length = off

[Makefile]
indent_style = tab

[*.{toml,cfg,ini}]
indent_size = 2

[*.py]
max_line_length = 100

[*.{db,sqlite,sqlite3}]
insert_final_newline = unset
