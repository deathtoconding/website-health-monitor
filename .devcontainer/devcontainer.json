{
  "name": "Website Health Monitor (dev)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]' && pre-commit install --install-hooks || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "github.copilot",
        "github.copilot-chat",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Website Health Monitor",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "WHM_DATABASE_PATH": "${containerWorkspaceFolder}/data/website-health-monitor.db"
  },
  "hostRequirements": { "cpus": 2 }
}
